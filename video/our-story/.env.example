# Required only for scripts/generate-vo.mjs (final voiceover render).
# Get a key at https://elevenlabs.io — copy this file to .env and fill in.
ELEVENLABS_API_KEY=
# Optional: pick a specific ElevenLabs voice ID (warm, measured narrator).
# Defaults to "Rachel" (21m00Tcm4TlvDq8ikWAM) if unset.
ELEVENLABS_VOICE_ID=
